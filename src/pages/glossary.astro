---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import GlossaryScrollApparatus from '../components/GlossaryScrollApparatus.astro';
import { glossaryFocusEntries } from '../data/glossaryFocusEntries';
---

<Layout
  title="Glossary"
  description="Glossary for Gravity's Rainbow."
>
  <Nav slot="nav" />

  <main class="site-page">
    <header class="page-header">
      <a class="page-back" href="/">&larr; The Zone</a>
      <h1 class="page-title">Glossary</h1>
    </header>

    <GlossaryScrollApparatus entries={glossaryFocusEntries} />
  </main>

  <Footer slot="footer" />
</Layout>
