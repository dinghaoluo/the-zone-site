---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import HomepagePreview from '../components/HomepagePreview.astro';
import StructuralPreview from '../components/StructuralPreview.astro';

const indexLinks = [
  { slug: 'glossary', label: 'Glossary' },
  { slug: 'reference', label: 'Reference' },
  { slug: 'network', label: 'Network' },
  { slug: 'episodes', label: 'Episodes' },
  { slug: 'terrain', label: 'Terrain' },
  { slug: 'language', label: 'Language' },
  { slug: 'methods', label: 'Methods' },
];
---

<Layout title="Home" description="A visual companion to Gravity's Rainbow (1973).">
  <Nav slot="nav" />

  <section class="hero" aria-labelledby="home-title">
    <div class="hero-inner">
      <h1 id="home-title" class="hero-title wordmark"><span>The</span><span>Zone</span></h1>
      <p class="hero-description">
        a visual companion to <em>Gravity's Rainbow</em> (1973)
      </p>
    </div>
  </section>

  <nav id="contents" class="contents" aria-label="Site sections">
    <ul class="contents-list" role="list">
      {indexLinks.map((link) => (
        <li>
          <div class="contents-entry contents-pending" aria-disabled="true">
            <span class="contents-label">{link.label}</span>
            <HomepagePreview slug={link.slug} />
          </div>
        </li>
      ))}
    </ul>
  </nav>

  <section class="episode-field" aria-label="Episode word counts">
    <div class="episode-field-inner">
      <div class="episode-plate">
        <StructuralPreview />
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
  .hero-inner,
  .contents {
    --homepage-gutter: clamp(4rem, 22vw, 22rem);
    width: min(100%, var(--measure-site));
    margin: 0 auto;
  }

  .hero-inner {
    padding: var(--space-xl) var(--homepage-gutter) var(--space-lg);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: 6.25rem;
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: 0;
    margin-left: -0.12em;
    color: var(--color-text);
  }

  .hero-description {
    max-width: 44rem;
    margin-top: var(--space-sm);
    font-family: var(--font-subtitle);
    font-size: var(--text-xl);
    line-height: 1.35;
    color: var(--color-text-secondary);
  }

  .hero-description em {
    color: var(--color-text);
  }

  .contents {
    padding: var(--space-lg) var(--homepage-gutter) var(--space-2xl);
  }

  .contents-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 8rem));
    width: fit-content;
    column-gap: var(--space-md);
    row-gap: clamp(1.5rem, 3vw, 3rem);
    list-style: none;
  }

  .contents-list > li {
    min-width: 0;
    list-style: none;
  }

  .contents-entry {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 0;
    color: var(--color-text);
  }

  .contents-pending {
    color: var(--color-text-dim);
    opacity: 0.46;
  }

  .contents-pending :global(.homepage-preview) {
    filter: grayscale(0.78);
    opacity: 0.78;
  }

  .contents-label {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    line-height: 1.1;
    text-align: left;
  }

  .contents-entry {
    transform-origin: left top;
  }

  .episode-field {
    padding: 0 var(--page-gutter) var(--space-2xl);
  }

  .episode-field-inner {
    width: min(100%, var(--measure-site));
    margin: 0 auto;
    padding: var(--space-xl) 0 0;
    border-top: 1px solid var(--color-rule);
  }

  .episode-plate {
    min-width: 0;
  }

  @media (max-width: 48rem) {
    .hero-inner,
    .contents {
      --homepage-gutter: var(--page-gutter);
    }

    .contents-list {
      width: 100%;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem 1rem;
    }

    .contents-entry {
      padding: 0;
    }

    .contents-label {
      font-size: 1.125rem;
    }
  }
</style>
