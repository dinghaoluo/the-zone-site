---
import Footer from '../components/Footer.astro';
import HomepagePreview from '../components/HomepagePreview.astro';
import Nav from '../components/Nav.astro';
import Notch from '../components/Notch.astro';
import StructuralPreview from '../components/StructuralPreview.astro';
import Layout from '../layouts/Layout.astro';

const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const sitePath = (path: string) => `${base}/${path.replace(/^\//, '')}`;

const indexLinks = [
  {
    slug: 'network',
    label: 'Network',
    available: true,
  },
  {
    slug: 'glossary',
    label: 'Glossary',
    available: true,
  },
  {
    slug: 'reference',
    label: 'Reference',
    available: true,
  },
  {
    slug: 'episodes',
    label: 'Episodes',
    available: false,
  },
  {
    slug: 'terrain',
    label: 'Terrain',
    available: false,
  },
  {
    slug: 'language',
    label: 'Language',
    available: false,
  },
  {
    slug: 'methods',
    label: 'Methods',
    available: false,
  },
];

const availableLinks = indexLinks.filter((link) => link.available);
const pendingLinks = indexLinks.filter((link) => !link.available);
---

<Layout title="Home" description="A visual companion to Gravity's Rainbow (1973).">
  <Nav slot="nav" />

  <div class="opening">
    <div class="opening-inner">
      <div class="opening-frame">
        <section class="hero" aria-labelledby="home-title">
          <div class="hero-inner">
            <h1 id="home-title" class="hero-title wordmark"><span>The</span><span>Zone</span></h1>
            <p class="hero-description">
              a visual companion to <i>Gravity's Rainbow</i>
            </p>
          </div>
        </section>

        <div class="opening-intro">
          <Notch />
          <p class="contents-intro prose-copy">Despite all its '<a href="https://www.nytimes.com/1974/05/08/archives/pulitzer-jurors-his-third-novel.html" target="_blank" rel="noopener">unreadable</a>' digressions, its great many technical terms in different languages, its historical documentary and reflections... reading <i>Gravity's Rainbow</i> is still one of those once-in-a-lifetime experiences. For me, coming to Pynchon's 1940s paranoid Europe at a stage when my own life involves looking at the cross-talk between countless neurones has made me appreciate (as well as dread) greatly the raw chaotic power of Pynchon's prose: its <a href="https://ebin.pub/mindful-pleasures-essays-on-thomas-pynchon-0316522317.html" target="_blank" rel="noopener">encyclopaedic</a> reputation sure is impressive, but it also frequently scares readers away, persuading people that 'one should <i>prepare</i> for <i>Gravity's Rainbow</i>', when the best part of the reading experience might be to lose oneself in all the chaos, digression, and confusion.</p>
          <p class="contents-intro prose-copy">That being said, external guidance did help me a great deal with reading this (at times) impenetrable novel. This site is my attempt to provide a visual reading companion to my second favourite book of all time. And I hope, just as I found great happiness in understanding the <i>Brennschluss</i> calculation after reading Niklas Riewald's <a href="https://niklasriewald.com/category/gravitys-rainbow/" target="_blank" rel="noopener">'The math behind <i>Gravity's Rainbow</i>'</a>, that other readers can do the same as they scroll through <i>The Zone</i>.</p>
        </div>
      </div>
    </div>
  </div>

  <nav id="contents" class="contents" aria-label="Site sections">
    <ul class="contents-list contents-list--available" role="list">
      {availableLinks.map((link) => (
        <li>
          <a class="contents-entry contents-link contents-link--available" href={sitePath(`${link.slug}/`)}>
            <HomepagePreview slug={link.slug} />
            <div class="contents-copy">
              <span class="contents-label">[ {link.label} ]{link.slug === 'network' && <span class="contents-wip"> work in progress</span>}</span>
              <p class="contents-description">
                {link.slug === 'glossary' ? (
                  <>scroll through or search for critical terms in <em>Gravity's Rainbow</em></>
                ) : link.slug === 'reference' ? (
                  <>other companions (wikis, essays...) with which to read the book</>
                ) : link.slug === 'network' ? (
                  <>mapping out characters and words in Pynchon's paranoia networks</>
                ) : null}
              </p>
            </div>
          </a>
        </li>
      ))}
    </ul>
    <p class="contents-pending-heading" id="coming-soon-title" role="heading" aria-level="2"><em>coming soon...</em></p>
    <ul class="contents-list contents-list--pending" role="list" aria-labelledby="coming-soon-title">
      {pendingLinks.map((link) => (
        <li>
          <div class="contents-entry contents-pending" aria-disabled="true">
            <span class="contents-label">[ {link.label} ]</span>
            <HomepagePreview slug={link.slug} />
          </div>
        </li>
      ))}
    </ul>
  </nav>

  <section class="episode-field" aria-label="Episode word counts">
    <div class="episode-field-inner">
      <div class="episode-plate">
        <StructuralPreview />
      </div>
    </div>
  </section>

  <section class="acknowledgements" aria-labelledby="acknowledgements-title">
    <div class="acknowledgements-inner">
      <Notch />
      <h2 id="acknowledgements-title" class="acknowledgements-title"><em>acknowledgements</em></h2>
      <p class="acknowledgements-body">
        This site would not have existed without Christian Swinehart's <a href="https://www.reddit.com/r/davidfosterwallace/comments/1sifhu5/introducing_infinite_digest_a_series_of_data/" target="_blank" rel="noopener">Reddit post</a> on <a href="https://samizdat.co/digest/" target="_blank" rel="noopener">Infinite Digest</a>, whose visualisations of <i>Infinite Jest</i> showed me what a book's structure looks like from above.
      </p>
      <p class="acknowledgements-body">
        For the reading of <i>Gravity's Rainbow</i> itself, I owe a great deal to the <a href="https://gravitys-rainbow.pynchonwiki.com/wiki/index.php?title=Main_Page" target="_blank" rel="noopener">Pynchon Wiki</a>, the wonderful community at <a href="https://www.reddit.com/r/ThomasPynchon/" target="_blank" rel="noopener">r/ThomasPynchon</a>, the <a href="https://redcircle.com/shows/pynchon-pals" target="_blank" rel="noopener">Pynchon Pals</a> podcast, Steven Weisenburger's <a href="https://www.ugapress.org/9780820328072/a-gravitys-rainbow-companion/" target="_blank" rel="noopener"><i>A Gravity's Rainbow Companion</i></a>, John Semley's <a href="https://www.gravitysrainbowguide.com" target="_blank" rel="noopener">'Proverbs for Paranoids: A Gravity's Rainbow Reading Guide'</a>, and Edward Mendelson's essays on Pynchon.
      </p>
      <p class="acknowledgements-body">
        The site is set in Major Mono Display for display type, Faculty Glyphic for headings, Newsreader for ledes, Piazzolla for prose, and Mononoki for monospace.
      </p>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
  .opening-inner,
  .contents {
    --homepage-reading: 40rem;
    width: min(100%, var(--measure-site));
    margin: 0 auto;
    padding-inline: var(--page-gutter);
  }

  .opening-frame {
    position: relative;
    width: min(100%, var(--homepage-reading));
    margin-inline: auto;
  }

  .hero-inner {
    padding-block: 2.8rem var(--space-lg);
  }

  .hero-title,
  .hero-description {
    width: 100%;
  }

  .hero-title {
    display: flex;
    font-family: var(--font-display);
    font-size: 6.25rem;
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: 0;
    transform: translateX(-0.12em);
    color: var(--color-text);
  }

  .hero-description {
    margin-top: var(--space-md);
    font-family: var(--font-subtitle);
    font-size: 1.55rem;
    font-weight: 450;
    font-optical-sizing: auto;
    line-height: 1.2;
    color: var(--color-text);
  }

  .contents {
    padding-block: var(--space-xl) var(--space-2xl);
    scroll-margin-top: calc(var(--nav-height, 3.5rem) + var(--space-md));
  }

  .contents-intro {
    max-width: var(--homepage-reading);
    text-align: left;
    margin-inline: auto;
  }

  .contents-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 8rem));
    width: fit-content;
    column-gap: var(--space-md);
    row-gap: clamp(1.5rem, 3vw, 3rem);
    margin-top: var(--space-xl);
    list-style: none;
  }

  .contents-list--pending {
    grid-template-columns: repeat(5, minmax(0, 1fr));
    width: min(100%, var(--homepage-reading));
    column-gap: 0.75rem;
    margin-top: var(--space-md);
    margin-inline: auto;
  }

  .contents-pending-heading {
    width: min(100%, var(--homepage-reading));
    margin-top: var(--space-xl);
    margin-inline: auto;
    font-family: var(--font-prose);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-text-dim);
  }

  .contents-list--available {
    grid-template-columns: minmax(0, 1fr);
    width: min(100%, var(--homepage-reading));
    row-gap: var(--space-lg);
    margin-top: 0;
    margin-inline: auto;
  }

  .contents-list > li {
    min-width: 0;
    list-style: none;
  }

  .contents-entry {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 0;
    color: var(--color-text);
    transform-origin: left top;
  }

  .contents-link--available {
    display: grid;
    grid-template-columns: 5.4rem minmax(0, 1fr);
    column-gap: var(--space-md);
    align-items: start;
  }

  .contents-link--available .contents-label {
    font-size: 1.5rem;
  }

  .contents-link--available :global(.homepage-preview) {
    margin-top: 0.1rem;
  }

  .contents-copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto;
    align-content: start;
    justify-items: start;
    gap: 0.35rem;
    width: 100%;
    min-width: 0;
    text-align: left;
  }

  .contents-description {
    display: block;
    margin: 0;
    font-family: var(--font-prose);
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--color-text-dim);
    transition: color 0.18s ease;
  }

  .contents-wip {
    margin-left: 0.75em;
    font-family: var(--font-prose);
    font-size: var(--text-xs);
    font-style: italic;
    color: var(--color-text-dim);
  }

  .contents-label {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    line-height: 1.1;
    text-align: left;
  }

  .contents-link--available .contents-label {
    position: relative;
    display: inline-block;
  }

  .contents-link--available .contents-label::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 2px;
    background: currentColor;
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.25s ease;
  }

  .contents-link--available:hover .contents-label::after,
  .contents-link--available:focus .contents-label::after,
  .contents-link--available:active .contents-label::after,
  .contents-link--available:focus-visible .contents-label::after {
    clip-path: inset(0);
  }

  @media (hover: none) and (pointer: coarse) {
    .contents-link--available .contents-label::after {
      clip-path: inset(0);
    }
  }

  .contents-link {
    position: relative;
    background-image: none;
    transition: color 0.18s ease;
  }

  .contents-link:hover,
  .contents-link:focus-visible {
    z-index: 1;
  }

  .contents-link:focus-visible {
    outline-offset: 0.2rem;
  }

  .contents-link:hover .contents-label,
  .contents-link:focus-visible .contents-label {
    color: var(--color-accent);
  }

  .contents-link--available:hover .contents-description,
  .contents-link--available:focus-visible .contents-description {
    color: var(--color-text-secondary);
  }

  .contents-pending {
    color: var(--color-text-dim);
    opacity: 0.46;
  }

  .contents-pending :global(.homepage-preview) {
    filter: grayscale(0.78);
    opacity: 0.78;
  }

  .acknowledgements {
    padding: 0 var(--page-gutter) var(--space-2xl);
  }

  .acknowledgements-inner {
    width: min(100%, var(--measure-site));
    margin: 0 auto;
  }

  .acknowledgements-title {
    width: min(100%, var(--homepage-reading, 40rem));
    margin: 0 auto var(--space-sm);
    font-family: var(--font-prose);
    font-size: var(--text-base);
    font-weight: 400;
    color: var(--color-text-dim);
  }

  .acknowledgements-body {
    width: min(100%, calc(var(--homepage-reading, 40rem) * 2 / 3));
    margin-right: auto;
    margin-left: max(0px, calc((100% - var(--homepage-reading, 40rem)) / 2));
    font-family: var(--font-prose);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .acknowledgements-body + .acknowledgements-body {
    margin-top: var(--space-sm);
  }

  .acknowledgements-body a {
    background-image: none;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.14em;
    text-decoration-color: transparent;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .acknowledgements-body a:hover,
  .acknowledgements-body a:focus-visible {
    text-decoration-color: currentColor;
  }

  .episode-field {
    padding: 0 var(--page-gutter) var(--space-2xl);
  }

  .episode-field-inner {
    width: min(100%, var(--measure-site));
    margin: 0 auto;
    padding: var(--space-xl) 0 0;
    border-top: 1px solid var(--color-rule);
  }

  .episode-plate {
    min-width: 0;
  }

  @media (max-width: 48rem) {
    .contents-link--available .contents-label::after {
      clip-path: inset(0 100% 0 0);
    }

    .contents-link--available .contents-label {
      text-decoration: none;
    }

    .contents {
      padding-bottom: var(--space-xl);
    }

    .hero-title {
      font-size: 4.5rem;
    }

    .hero-description {
      font-size: 1.35rem;
    }

    .contents-list {
      width: 100%;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem 1rem;
    }

    .contents-list--available,
    .contents-list--pending {
      width: min(100%, var(--homepage-reading));
    }

    .contents-list--available {
      grid-template-columns: minmax(0, 1fr);
    }

    .contents-link--available {
      grid-template-columns: 4.8rem minmax(0, 1fr);
      column-gap: var(--space-md);
    }

    .contents-link--available .contents-label {
      font-size: 1.3rem;
    }

    .contents-entry {
      padding: 0;
    }

    .contents-label {
      font-size: 1.125rem;
    }
  }

  @media (min-width: 72rem) {
    .contents-description {
      white-space: nowrap;
    }
  }

  @media (max-width: 30rem) {
    .hero-title {
      font-size: 4rem;
    }

    .contents-label {
      font-size: 1.05rem;
    }
  }

  @media (max-width: 22rem) {
    .hero-title {
      font-size: 3.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contents-list .contents-link {
      transform: none;
    }
  }

</style>
