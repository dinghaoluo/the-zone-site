---
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import Layout from '../layouts/Layout.astro';

const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
---

<Layout title="Methods" description="How data is collected, structured, and visualised across The Zone.">
  <Nav slot="nav" />

  <main class="site-page methods-page" id="main-content">
    <header class="page-header">
      <a class="page-back" href={`${base}/`}>&larr; The Zone</a>
      <h1 class="page-title">Methods</h1>
      <p class="page-wip">[ <i>work in progress</i> ]</p>
    </header>
  </main>

  <Footer slot="footer" />
</Layout>

<style>
  .methods-page {
    max-width: var(--measure-site);
    margin-inline: auto;
    padding-inline: var(--page-gutter);
  }

  .page-wip {
    margin-top: var(--space-sm);
    font-family: var(--font-prose);
    font-size: var(--text-xs);
    color: var(--color-text-dim);
  }
</style>
