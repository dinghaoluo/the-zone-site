    font-family: var(--font-prose);
    font-size: var(--text-xl);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-text-dim);
    margin: var(--space-lg) 0 var(--space-sm);
    text-transform: none;
  }

  .methods-body h4:first-of-type {
    margin-top: 0;
  }

  .methods-body .prose-copy {
