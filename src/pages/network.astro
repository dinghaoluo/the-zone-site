<style>
  .network-backdrop {
    position: fixed;
    top: var(--nav-height, 3.5rem);
    left: 0;
    right: 0;
    height: 60vh;
    pointer-events: none;
    z-index: 0;
    opacity: 0.09;
    transition: opacity 0.1s linear;
    mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 50%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 50%, transparent 100%);
  }

  .backdrop-graph {
    width: 100%;
    height: 100%;
  }

  .graph-edges line {
    stroke: var(--color-text-dim);
    stroke-width: 0.8;
    opacity: 0.5;
  }

  .graph-nodes .node {
    stroke-width: 1.4;
    fill: var(--color-text-dim);
    stroke: var(--color-text-dim);
  }

  .node--a { stroke: var(--network-quest); fill: var(--network-quest); }
  .node--b { stroke: var(--network-counterforce); fill: var(--network-counterforce); }
  .node--c { stroke: var(--network-rocket); fill: var(--network-rocket); }
  .node--d { stroke: var(--network-pokler); fill: var(--network-pokler); }
  .node--e { stroke: var(--network-afterlives); fill: var(--network-afterlives); }

  .network-page {
    position: relative;
    z-index: 1;
    width: min(92%, 90rem);
    margin: 0 auto;
  }

  .network-header {
    padding-block: var(--space-lg) var(--space-md);
    padding-inline: var(--page-gutter);
    max-width: var(--measure-site);
    margin-inline: auto;
    width: 100%;
  }

  .network-header .page-back {
    text-align: left;
  }

  .network-header .page-title {
    width: auto;
    margin-inline: auto;
    text-align: center;
  }

  .network-lede {
    max-width: var(--measure-reading);
    margin-inline: auto;
    padding-bottom: var(--space-xl);
    font-family: var(--font-subtitle);
    font-size: var(--text-lg);
    line-height: var(--lh-prose);
    color: var(--color-text-secondary);
    text-align: center;
  }

  .plot-plate {
    margin: 0;
    padding: 0;
  }

  .network-section {
    display: grid;
    grid-template-columns: 1fr 1.8fr;
    gap: var(--space-xl);
    align-items: start;
    margin-top: var(--space-2xl);
    padding-left: var(--space-xl);
  }

  .section-prose {
    max-width: 32rem;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: var(--text-h3);
    margin-bottom: var(--space-md);
  }

  .section-prose p {
    font-family: var(--font-prose);
    font-size: var(--text-prose);
    line-height: var(--lh-prose);
    color: var(--color-text-secondary);
  }

  .section-chart {
    margin: 0;
    padding: 0;
    min-width: 0;
    overflow: visible;
  }

  @media (max-width: 64rem) {
    .network-section {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .network-backdrop {
      opacity: 0.14;
    }

    .graph-nodes .node animate {
      display: none;
    }
  }
</style>

<script>
  const backdrop = document.getElementById('network-backdrop');
  if (backdrop) {
    const fadeStart = 80;
    const fadeEnd = 400;
    let ticking = false;

    function updateOpacity() {
      const scrollY = window.scrollY;
      let opacity = 0.09;
      if (scrollY > fadeStart) {
        const progress = Math.min((scrollY - fadeStart) / (fadeEnd - fadeStart), 1);
        opacity = 0.09 * (1 - progress);
      }
      backdrop!.style.opacity = String(opacity);
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(updateOpacity);
        ticking = true;
      }
    }, { passive: true });
  }
</script>
