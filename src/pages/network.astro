<script>
  import { lexicalSelectionDetail, lexicalTrajectoryEvents } from '../lib/lexicalDensity';

  const networkTocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.network-toc a[href^="#"]'));
  const networkReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let sectionScrollFrame = 0;

  function easeInOutCubic(progress: number) {
    return progress < 0.5
      ? 4 * progress * progress * progress
      : 1 - Math.pow(-2 * progress + 2, 3) / 2;
  }

  function scrollToNetworkSection(event: MouseEvent, link: HTMLAnchorElement) {
    if (networkReducedMotion.matches) return;
    const targetId = decodeURIComponent(new URL(link.href).hash.slice(1));
    const target = document.getElementById(targetId);
    if (!target) return;

    event.preventDefault();
    window.cancelAnimationFrame(sectionScrollFrame);
    const navHeight = document.querySelector<HTMLElement>('.nav')?.getBoundingClientRect().height ?? 0;
    const targetY = Math.max(0, target.getBoundingClientRect().top + window.scrollY - navHeight - 16);
    const startY = window.scrollY;
    const distance = targetY - startY;
    const duration = Math.min(1800, Math.max(900, Math.abs(distance) * 0.5));
    const startedAt = performance.now();
    const previousScrollBehaviour = document.documentElement.style.scrollBehavior;
    document.documentElement.style.scrollBehavior = 'auto';
    history.pushState(null, '', link.href);

    function step(now: number) {
      const progress = Math.min(1, (now - startedAt) / duration);
      window.scrollTo(0, startY + distance * easeInOutCubic(progress));
      if (progress < 1) {
        sectionScrollFrame = window.requestAnimationFrame(step);
      } else {
        document.documentElement.style.scrollBehavior = previousScrollBehaviour;
      }
    }

    sectionScrollFrame = window.requestAnimationFrame(step);
  }

  networkTocLinks.forEach((link) => {
    link.addEventListener('click', (event) => scrollToNetworkSection(event, link));
  });

  const matrixStage = document.querySelector<HTMLElement>('.matrix-stage')!;
  const matrixCopy = matrixStage.querySelector<HTMLElement>('.matrix-copy')!;
  const matrixParagraph = matrixCopy.querySelector<HTMLElement>('p')!;

  function fitMatrixCaption() {
    if (getComputedStyle(matrixCopy).position !== 'absolute') return;
    const width = matrixStage.clientWidth;
    matrixStage.style.setProperty('--matrix-width', `${width}px`);
    let low = 0;
    let high = width * 0.15;
    // move the right edge without moving the exclusion along the matrix diagonal
    for (let step = 0; step < 8; step++) {
      const inset = (low + high) / 2;
      matrixStage.style.setProperty('--matrix-inset', `${inset}px`);
      if (matrixParagraph.offsetHeight <= matrixCopy.clientHeight - 4) low = inset;
      else high = inset;
    }
    matrixStage.style.setProperty('--matrix-inset', `${low}px`);
  }

  document.fonts.ready.then(fitMatrixCaption);
  new ResizeObserver(fitMatrixCaption).observe(matrixStage);

  const networkLede = document.querySelector<HTMLElement>('[data-network-lede]');
  const requestedLedeVariant = new URLSearchParams(window.location.search).get('lede');
  const mobileLedeTooltip = window.matchMedia('(max-width: 48rem)');
  const activeLedeVariant = requestedLedeVariant === 'tooltip'
    || (requestedLedeVariant !== 'marginal' && mobileLedeTooltip.matches)
    ? 'tooltip'
    : 'marginal';
  const ledeNotes = document.querySelector<HTMLElement>('[data-lede-notes]');
  const ledeTermPairs = Array.from(document.querySelectorAll<HTMLElement>('.lede-term-pair'));
  const tooltipVariantActive = activeLedeVariant === 'tooltip';

  if (networkLede) networkLede.dataset.ledeVariant = activeLedeVariant;
  if (ledeNotes) ledeNotes.hidden = tooltipVariantActive;
  ledeTermPairs.forEach((pair) => {
    const plainTerm = pair.querySelector<HTMLElement>('[data-lede-term-copy]');
    const tooltipTerm = pair.querySelector<HTMLButtonElement>('[data-lede-trigger]');
    if (plainTerm) plainTerm.hidden = tooltipVariantActive;
    if (tooltipTerm) tooltipTerm.hidden = !tooltipVariantActive;
  });

  const ledeCopy = document.querySelector<HTMLElement>('.lede-copy');
  const ledeAnchors = Array.from(document.querySelectorAll<HTMLElement>('[data-lede-anchor]'));
  const ledeMarginNotes = Array.from(document.querySelectorAll<HTMLElement>('[data-lede-note]'));
  const ledeNotesDesktop = window.matchMedia('(min-width: 66.01rem)');
  let ledeNotesFrame = 0;

  function positionLedeMarginNotes() {
    if (!networkLede || !ledeNotes || tooltipVariantActive || !ledeNotesDesktop.matches) {
      ledeNotes?.classList.remove('is-anchored');
      ledeNotes?.style.removeProperty('visibility');
      ledeMarginNotes.forEach((note) => note.style.removeProperty('top'));
      networkLede?.style.removeProperty('--lede-notes-overflow');
      return;
    }

    ledeNotes.style.visibility = 'hidden';
    ledeNotes.classList.add('is-anchored');
    ledeMarginNotes.forEach((note) => {
      note.style.top = '0';
    });

    const notesRect = ledeNotes.getBoundingClientRect();
    let nextTop = 0;

    ledeMarginNotes.forEach((note) => {
      const anchor = ledeAnchors.find(
        (candidate) => candidate.dataset.ledeAnchor === note.dataset.ledeNote,
      );
      if (!anchor) return;

      const anchorRect = anchor.getClientRects()[0] ?? anchor.getBoundingClientRect();
      const desiredTop = Math.max(0, anchorRect.top - notesRect.top);
      const top = Math.max(desiredTop, nextTop);
      note.style.top = `${top}px`;
      nextTop = top + note.offsetHeight + 10;
    });

    const overflow = Math.max(0, nextTop - 10 - ledeNotes.clientHeight);
    networkLede.style.setProperty('--lede-notes-overflow', `${overflow}px`);
    ledeNotes.style.removeProperty('visibility');
  }

  function queueLedeMarginNotesPosition() {
    window.cancelAnimationFrame(ledeNotesFrame);
    ledeNotesFrame = window.requestAnimationFrame(positionLedeMarginNotes);
  }

  queueLedeMarginNotesPosition();
  document.fonts.ready.then(queueLedeMarginNotesPosition);
  ledeNotesDesktop.addEventListener('change', queueLedeMarginNotesPosition);
  if (ledeCopy && 'ResizeObserver' in window) {
    const observer = new ResizeObserver(queueLedeMarginNotesPosition);
    observer.observe(ledeCopy);
  }

  const ledeTooltip = document.querySelector<HTMLElement>('[data-lede-tooltip]');
  const ledeTooltipQuote = document.querySelector<HTMLElement>('[data-lede-tooltip-quote]');
  const ledeTooltipEpisode = document.querySelector<HTMLElement>('[data-lede-tooltip-episode]');
  const ledeTriggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lede-trigger]'));
  let activeLedeTrigger: HTMLButtonElement | null = null;
  let ledeTooltipPinned = false;
  let suppressLedeTooltipFocus = false;
  let ledeTooltipCloseTimer: number | undefined;
  let ledeTooltipFrame = 0;

  function clearLedeTooltipTimer() {
    if (ledeTooltipCloseTimer !== undefined) {
      window.clearTimeout(ledeTooltipCloseTimer);
      ledeTooltipCloseTimer = undefined;
    }
  }

  function positionLedeTooltip() {
    if (!activeLedeTrigger || !ledeTooltip?.classList.contains('is-open')) return;

    const gutter = 12;
    const gap = mobileLedeTooltip.matches ? 0 : 10;
    const navBottom = document.querySelector<HTMLElement>('.nav')?.getBoundingClientRect().bottom ?? 0;
    const topGutter = Math.max(gutter, navBottom + 8);
    ledeTooltip.style.right = 'auto';
    ledeTooltip.style.bottom = 'auto';
    ledeTooltip.style.width = '';
    ledeTooltip.dataset.placement = 'above';

    const triggerRect = activeLedeTrigger.getBoundingClientRect();
    const tooltipWidth = ledeTooltip.offsetWidth;
    const tooltipHeight = ledeTooltip.offsetHeight;
    const above = triggerRect.top - tooltipHeight - gap;
    const below = triggerRect.bottom + gap;
    const fitsAbove = above >= topGutter;
    const fitsBelow = below + tooltipHeight <= window.innerHeight - gutter;

    if (!fitsAbove && !fitsBelow) {
      ledeTooltip.dataset.placement = 'dock';
      ledeTooltip.style.left = `${gutter}px`;
      ledeTooltip.style.right = `${gutter}px`;
      ledeTooltip.style.top = 'auto';
      ledeTooltip.style.bottom = `${gutter}px`;
      ledeTooltip.style.bottom = `calc(${gutter}px + env(safe-area-inset-bottom))`;
      ledeTooltip.style.width = 'auto';
      return;
    }

    const left = Math.max(
      gutter,
      Math.min(
        triggerRect.left + triggerRect.width / 2 - tooltipWidth / 2,
        window.innerWidth - tooltipWidth - gutter,
      ),
    );

    ledeTooltip.style.left = `${left}px`;
    if (fitsAbove) {
      ledeTooltip.style.top = `${above}px`;
    } else {
      ledeTooltip.dataset.placement = 'below';
      ledeTooltip.style.top = `${below}px`;
    }
  }

  function queueLedeTooltipPosition() {
    window.cancelAnimationFrame(ledeTooltipFrame);
    ledeTooltipFrame = window.requestAnimationFrame(positionLedeTooltip);
  }

  function openLedeTooltip(trigger: HTMLButtonElement, pinned: boolean) {
    if (!ledeTooltip || !ledeTooltipQuote || !ledeTooltipEpisode) return;
    clearLedeTooltipTimer();

    if (activeLedeTrigger && activeLedeTrigger !== trigger) {
      activeLedeTrigger.setAttribute('aria-expanded', 'false');
      activeLedeTrigger.removeAttribute('aria-describedby');
    }

    activeLedeTrigger = trigger;
    ledeTooltipPinned = pinned;
    ledeTooltipQuote.textContent = `‘${trigger.dataset.quote ?? ''}’`;
    ledeTooltipEpisode.textContent = `(${trigger.dataset.episode ?? ''})`;
    trigger.setAttribute('aria-expanded', 'true');
    trigger.setAttribute('aria-describedby', ledeTooltip.id);
    ledeTooltip.setAttribute('aria-hidden', 'false');
    ledeTooltip.classList.add('is-open');
    queueLedeTooltipPosition();
  }

  function closeLedeTooltip(restoreFocus = false) {
    if (!activeLedeTrigger || !ledeTooltip) return;
    clearLedeTooltipTimer();

    const previousTrigger = activeLedeTrigger;
    previousTrigger.setAttribute('aria-expanded', 'false');
    previousTrigger.removeAttribute('aria-describedby');
    activeLedeTrigger = null;
    ledeTooltipPinned = false;
    ledeTooltip.setAttribute('aria-hidden', 'true');
    ledeTooltip.classList.remove('is-open');
    if (restoreFocus) {
      suppressLedeTooltipFocus = true;
      previousTrigger.focus();
      window.requestAnimationFrame(() => {
        suppressLedeTooltipFocus = false;
      });
    }
  }

  function scheduleLedeTooltipClose() {
    clearLedeTooltipTimer();
    ledeTooltipCloseTimer = window.setTimeout(() => {
      const triggerHasFocus = document.activeElement === activeLedeTrigger;
      const tooltipIsHovered = ledeTooltip?.matches(':hover') ?? false;
      if (!ledeTooltipPinned && !triggerHasFocus && !tooltipIsHovered) closeLedeTooltip();
    }, 140);
  }

  ledeTriggers.forEach((trigger) => {
    trigger.addEventListener('pointerenter', (event) => {
      if (event.pointerType !== 'touch') openLedeTooltip(trigger, false);
    });

    trigger.addEventListener('pointerleave', (event) => {
      if (event.pointerType !== 'touch') scheduleLedeTooltipClose();
    });

    trigger.addEventListener('focus', () => {
      if (suppressLedeTooltipFocus) return;
      openLedeTooltip(trigger, false);
    });
    trigger.addEventListener('blur', () => {
      if (!ledeTooltipPinned) scheduleLedeTooltipClose();
    });

    trigger.addEventListener('click', () => {
      if (activeLedeTrigger === trigger && ledeTooltipPinned) closeLedeTooltip();
      else openLedeTooltip(trigger, true);
    });
  });

  ledeTooltip?.addEventListener('pointerenter', clearLedeTooltipTimer);
  ledeTooltip?.addEventListener('pointerleave', scheduleLedeTooltipClose);

  document.addEventListener('pointerdown', (event) => {
    if (!activeLedeTrigger || !ledeTooltip) return;
    const target = event.target;
    if (!(target instanceof Node)) return;
    if (!activeLedeTrigger.contains(target) && !ledeTooltip.contains(target)) closeLedeTooltip();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !activeLedeTrigger) return;
    event.preventDefault();
    closeLedeTooltip(true);
  });

  window.addEventListener('scroll', () => {
    if (activeLedeTrigger) queueLedeTooltipPosition();
  }, { passive: true });
  window.addEventListener('resize', () => {
    queueLedeMarginNotesPosition();
    if (activeLedeTrigger) queueLedeTooltipPosition();
  });

  const matrixPairRefs = document.querySelectorAll<HTMLButtonElement>('[data-matrix-pair], [data-matrix-pairs]');
  const mobileNetwork = window.matchMedia('(max-width: 48rem)');
  const matrixTouchInput = window.matchMedia('(hover: none), (pointer: coarse)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function setMatrixPairHighlight(matrixPairRef: HTMLButtonElement, active: boolean) {
    const pairs = matrixPairRef.dataset.matrixPairs?.split(';')
      ?? (matrixPairRef.dataset.matrixPair ? [matrixPairRef.dataset.matrixPair] : []);
    if (pairs.length === 0) return;

    matrixPairRefs.forEach((ref) => {
      if (active && ref !== matrixPairRef) ref.setAttribute('aria-pressed', 'false');
    });
    matrixPairRef.setAttribute('aria-pressed', String(active));
    document.dispatchEvent(new CustomEvent('matrix-pair-highlight', {
      detail: {
        pairs,
        colour: matrixPairRef.dataset.matrixColour,
        active,
        trigger: active ? matrixPairRef : null,
      },
    }));
  }

  matrixPairRefs.forEach((matrixPairRef) => {
    matrixPairRef.addEventListener('pointerenter', (event) => {
      if (!mobileNetwork.matches && event.pointerType !== 'touch') setMatrixPairHighlight(matrixPairRef, true);
    });

    matrixPairRef.addEventListener('pointerleave', (event) => {
      if (!mobileNetwork.matches && event.pointerType !== 'touch') setMatrixPairHighlight(matrixPairRef, false);
    });

    matrixPairRef.addEventListener('focus', () => {
      if (!mobileNetwork.matches && !matrixTouchInput.matches) setMatrixPairHighlight(matrixPairRef, true);
    });
    matrixPairRef.addEventListener('blur', () => {
      if (!mobileNetwork.matches && !matrixTouchInput.matches) setMatrixPairHighlight(matrixPairRef, false);
    });

    matrixPairRef.addEventListener('click', () => {
      if (!mobileNetwork.matches && !matrixTouchInput.matches) return;

      const nextActive = matrixPairRef.getAttribute('aria-pressed') !== 'true';
      setMatrixPairHighlight(matrixPairRef, nextActive);
    });
  });

  function clearMatrixPairHighlight() {
    const activeRef = Array.from(matrixPairRefs).find(ref => ref.getAttribute('aria-pressed') === 'true');
    if (activeRef) setMatrixPairHighlight(activeRef, false);
  }

  document.addEventListener('pointerdown', event => {
    if (!mobileNetwork.matches) return;
    const target = event.target;
    if (target instanceof Element && target.closest('[data-matrix-pair], [data-matrix-pairs]')) return;
    clearMatrixPairHighlight();
  });

  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && mobileNetwork.matches) clearMatrixPairHighlight();
  });

  type ReadingReference = {
    selector: string;
    eventName: string;
    clearEventName: string;
    commitEventName: string;
    key: 'displayOrder' | 'index';
  };

  type ReadingSelection = {
    displayOrder?: number;
    displayOrders?: number[];
    index?: number;
    locked?: boolean;
  } | null;

  function wireReadingReferences(config: ReadingReference) {
    const refs = Array.from(document.querySelectorAll<HTMLButtonElement>(config.selector));
    let pinned: HTMLButtonElement | null = null;
    let externalPinned = false;

    function valuesFor(ref: HTMLButtonElement) {
      const value = ref.dataset[config.key === 'displayOrder' ? 'trajectorySelect' : 'castBoundarySelect'] ?? '';
      return value.split(',').map((entry) => Number(entry.trim())).filter(Number.isFinite);
    }

    function detailFor(ref: HTMLButtonElement, locked: boolean): ReadingSelection {
      const values = valuesFor(ref);
      if (!values.length) return null;
      return config.key === 'displayOrder'
        ? { displayOrder: values[0], displayOrders: values, locked }
        : { index: values[0], locked };
    }

    function dispatch(ref: HTMLButtonElement | null, locked = false) {
      refs.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === pinned)));
      const detail = ref ? detailFor(ref, locked) : null;
      document.dispatchEvent(new CustomEvent<ReadingSelection>(config.eventName, { detail }));
    }

    document.addEventListener(config.clearEventName, () => {
      pinned = null;
      externalPinned = false;
      refs.forEach((candidate) => candidate.setAttribute('aria-pressed', 'false'));
    });

    document.addEventListener(config.commitEventName, (event) => {
      const detail = (event as CustomEvent<ReadingSelection>).detail;
      const value = config.key === 'displayOrder' ? detail?.displayOrder : detail?.index;
      const committedValues = config.key === 'displayOrder' && detail?.displayOrders?.length
        ? detail.displayOrders
        : value === undefined ? [] : [value];
      const committed = refs.find((candidate) => {
        const values = valuesFor(candidate);
        return values.length === committedValues.length
          && values.every((candidateValue, index) => candidateValue === committedValues[index]);
      }) ?? null;
      pinned = committed;
      externalPinned = committed === null;
      refs.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === pinned)));
    });

    refs.forEach((ref) => {
      ref.addEventListener('pointerenter', (event) => {
        if (event.pointerType !== 'touch' && (pinned === null && !externalPinned)) dispatch(ref, false);
      });
      ref.addEventListener('pointerleave', (event) => {
        if (event.pointerType === 'touch') return;
        if (pinned === null && !externalPinned) dispatch(null);
      });
      ref.addEventListener('focus', () => {
        if (pinned === null && !externalPinned) dispatch(ref, false);
      });
      ref.addEventListener('blur', () => {
        if (pinned === null && !externalPinned) dispatch(null);
      });
      ref.addEventListener('click', () => {
        if (pinned === ref) {
          pinned = null;
          dispatch(null);
          return;
        }
        pinned = ref;
        externalPinned = false;
        dispatch(ref, true);
      });
    });

    return () => {
      if (pinned !== null || externalPinned) {
        pinned = null;
        externalPinned = false;
        dispatch(null);
      }
    };
  }

  const clearTrajectoryReference = wireReadingReferences({
    selector: '[data-trajectory-select]',
    eventName: 'trajectory-select',
    clearEventName: 'trajectory-selection-cleared',
    commitEventName: 'trajectory-selection-committed',
    key: 'displayOrder',
  });
  const clearCastReference = wireReadingReferences({
    selector: '[data-cast-boundary-select]',
    eventName: 'cast-boundary-select',
    clearEventName: 'cast-boundary-selection-cleared',
    commitEventName: 'cast-boundary-selection-committed',
    key: 'index',
  });

  type LexicalReferenceDetail = {
    word: string;
    cohortDisplayOrder: number;
    episodeId?: string;
    locked?: boolean;
  } | null;

  function wireLexicalReferences() {
    const refs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lexical-trajectory-select]'));
    const touchInput = window.matchMedia('(hover: none), (pointer: coarse)');
    let pinned: HTMLButtonElement | null = null;
    let externalPinned = false;

    function updatePressed() {
      refs.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === pinned)));
    }

    function detailFor(ref: HTMLButtonElement, locked = false): LexicalReferenceDetail {
      const word = ref.dataset.lexicalTrajectorySelect?.trim() ?? '';
      const cohortDisplayOrder = Number(ref.dataset.lexicalCohortOrder);
      const episodeId = ref.dataset.lexicalEpisode?.trim();
      return lexicalSelectionDetail(word, cohortDisplayOrder, episodeId, locked);
    }

    function dispatch(ref: HTMLButtonElement | null, locked = false) {
      updatePressed();
      document.dispatchEvent(new CustomEvent<LexicalReferenceDetail>(lexicalTrajectoryEvents.select, {
        detail: ref ? detailFor(ref, locked) : null,
      }));
    }

    document.addEventListener(lexicalTrajectoryEvents.cleared, () => {
      pinned = null;
      externalPinned = false;
      updatePressed();
    });

    document.addEventListener(lexicalTrajectoryEvents.committed, (event) => {
      const detail = (event as CustomEvent<Exclude<LexicalReferenceDetail, null>>).detail;
      const committed = detail?.episodeId
        ? refs.find((ref) => (
          ref.dataset.lexicalTrajectorySelect?.trim() === detail.word
          && Number(ref.dataset.lexicalCohortOrder) === detail.cohortDisplayOrder
          && ref.dataset.lexicalEpisode?.trim() === detail.episodeId
        )) ?? null
        : null;
      pinned = committed;
      externalPinned = committed === null;
      updatePressed();
    });

    refs.forEach((ref) => {
      ref.addEventListener('pointerenter', (event) => {
        if (event.pointerType !== 'touch' && pinned === null && !externalPinned) dispatch(ref, false);
      });
      ref.addEventListener('pointerleave', (event) => {
        if (event.pointerType !== 'touch' && pinned === null && !externalPinned) dispatch(null);
      });
      ref.addEventListener('focus', () => {
        if (pinned === null && !externalPinned) dispatch(ref, false);
      });
      ref.addEventListener('blur', () => {
        if (pinned === null && !externalPinned) dispatch(null);
      });
      ref.addEventListener('click', () => {
        if (pinned === ref) {
          pinned = null;
          dispatch(null);
          return;
        }
        pinned = ref;
        externalPinned = false;
        dispatch(ref, true);
        if (touchInput.matches) {
          document.getElementById('lexical-area-traces')?.scrollIntoView({
            behavior: reducedMotion.matches ? 'auto' : 'smooth',
            block: 'center',
          });
        }
      });
    });

    return () => {
      pinned = null;
      externalPinned = false;
      dispatch(null);
    };
  }

  const clearLexicalReference = wireLexicalReferences();

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    clearTrajectoryReference();
    clearCastReference();
    clearLexicalReference();
  });

  const backdrop = document.getElementById('network-backdrop');
  if (backdrop) {
    const backgroundGraph = backdrop.querySelector('svg')!;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    function updateBackgroundMotion() {
      if (reducedMotion.matches) backgroundGraph.pauseAnimations();
      else backgroundGraph.unpauseAnimations();
    }
    updateBackgroundMotion();
    reducedMotion.addEventListener('change', updateBackgroundMotion);
    const fadeStart = 80;
    const fadeEnd = 400;
    let ticking = false;

    function updateOpacity() {
      const scrollY = window.scrollY;
      let opacity = 0.09;
      if (scrollY > fadeStart) {
        const progress = Math.min((scrollY - fadeStart) / (fadeEnd - fadeStart), 1);
        opacity = 0.09 * (1 - progress);
      }
      backdrop!.style.opacity = String(opacity);
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(updateOpacity);
        ticking = true;
      }
    }, { passive: true });
    updateOpacity();
  }
</script>
