---
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import references from '../data/references.json';
import Layout from '../layouts/Layout.astro';

const categories = [
  { id: 'all', label: 'ALL' },
  { id: 'analyses', label: 'analyses' },
  { id: 'guides', label: 'guides' },
  { id: 'community', label: 'community' },
  { id: 'audio-video', label: 'audio and video' },
];

const items = references;
const categoryLabels: Record<string, string> = Object.fromEntries(
  categories.map(category => [category.id, category.label])
);

const plainText = (value: string) => value
  .replace(/<[^>]+>/g, ' ')
  .replace(/\s+/g, ' ')
  .trim();
---

<Layout title="References" description="Bibliography and source notes for The Zone.">
  <Nav slot="nav" />

  <main class="site-page reference-page" id="main-content">
    <header class="page-header reference-header">
      <a class="page-back" href="/">&larr; The Zone</a>
      <h1 class="page-title">References</h1>
    </header>

    <section class="reference-apparatus" aria-label="Reference filters">
      <div class="reference-apparatus-inner">
        <fieldset class="reference-category-filter">
          <legend>Browse by category</legend>
          <div class="reference-category-grid" id="reference-category-filter">
            {categories.map(category => {
              return (
                <button
                  class:list={[
                    'reference-category-control',
                    { active: category.id === 'all', 'is-all': category.id === 'all' },
                  ]}
                  type="button"
                  data-value={category.id}
                  aria-label={category.label}
                  aria-pressed={category.id === 'all' ? 'true' : 'false'}
                >
                  <span>{category.label}</span>
                </button>
              );
            })}
          </div>
        </fieldset>
      </div>
    </section>

    <section class="reference-results" aria-label="Reference list">
      <div class="reference-results-inner">
        <div class="reference-list" id="reference-list">
          {items.map(item => (
            <article
              class="reference-entry"
              data-reference-entry
              data-category={item.category}
            >
              <div class="reference-entry-meta">
                <button
                  class="reference-entry-category"
                  type="button"
                  data-category-filter={item.category}
                  aria-label={`Show ${categoryLabels[item.category]} references`}
                >
                  <span data-reference-category-text>{categoryLabels[item.category] ?? item.category}</span>
                </button>
              </div>
              <div class="reference-entry-body">
                <h2 class="reference-entry-title">
                  {item.url ? (
                    <a
                      href={item.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${plainText(item.title)} (opens in a new tab)`}
                    >
                      <span data-reference-title-text set:html={item.title} />
                      <span class="reference-entry-external" aria-hidden="true">↗</span>
                    </a>
                  ) : (
                    <span data-reference-title-text set:html={item.title} />
                  )}
                </h2>
                <p class="reference-entry-byline">
                  <span data-reference-creators-text set:html={item.creators} />
                  {item.year && <span class="reference-entry-year" data-reference-year-text> · {item.year}</span>}
                </p>
                <p
                  class="reference-entry-note"
                  data-reference-note-text
                  set:html={item.shortAnnotation}
                />
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</Layout>

<script>
  const referencePage = document.querySelector<HTMLElement>('.reference-page');

  if (referencePage) {
    const cards = Array.from(referencePage.querySelectorAll<HTMLElement>('[data-reference-entry]'));
    const categoryControls = Array.from(
      referencePage.querySelectorAll<HTMLButtonElement>('.reference-category-control')
    );
    const entryCategoryControls = Array.from(
      referencePage.querySelectorAll<HTMLButtonElement>('[data-category-filter]')
    );

    let activeCategory = 'all';

    function setCategory(value: string): void {
      activeCategory = value || 'all';
      categoryControls.forEach(control => {
        const active = control.dataset.value === activeCategory;
        control.classList.toggle('active', active);
        control.setAttribute('aria-pressed', String(active));
      });
      applyFilters();
    }

    function applyFilters(): void {
      let visible = 0;
      cards.forEach(card => {
        const matchesCategory = activeCategory === 'all'
          || card.dataset.category === activeCategory;
        card.hidden = !matchesCategory;
        if (matchesCategory) visible += 1;
      });
    }

    categoryControls.forEach(control => {
      control.addEventListener('click', () => setCategory(control.dataset.value ?? 'all'));
    });

    entryCategoryControls.forEach(control => {
      control.addEventListener('click', () => setCategory(control.dataset.categoryFilter ?? 'all'));
    });

    applyFilters();
  }
</script>

<style>
  .reference-apparatus {
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
    background: var(--color-bg);
  }

  .reference-page [hidden] {
    display: none !important;
  }

  .reference-apparatus-inner,
  .reference-results-inner {
    width: min(100%, var(--measure-site));
    margin-inline: auto;
    padding-inline: var(--page-gutter);
  }

  .reference-apparatus-inner {
    display: grid;
    gap: clamp(var(--space-lg), 5vw, var(--space-xl));
    padding-block: var(--space-lg);
  }

  .reference-category-filter legend {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .reference-category-filter {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .reference-category-grid {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-lg);
  }

  .reference-category-control {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-width: 0;
    min-height: 44px;
    padding: 0.35rem 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-weight: 400;
    letter-spacing: 0.02em;
    text-align: left;
    cursor: pointer;
    transition: color 0.18s ease;
  }

  .reference-category-control:hover,
  .reference-category-control:focus-visible {
    color: var(--color-accent);
  }

  .reference-category-control.active {
    color: var(--color-accent);
  }

  .reference-category-control span {
    position: relative;
  }

  .reference-category-control span::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  .reference-category-control:hover span::after,
  .reference-category-control:focus-visible span::after,
  .reference-category-control.active span::after {
    transform: scaleX(1);
  }

  .reference-category-control.is-all {
    margin-right: var(--space-sm);
    padding-right: var(--space-lg);
    border-right: 1px solid var(--color-border);
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .reference-results {
    padding: var(--space-xl) 0 var(--space-xl);
  }

  @media (min-width: 56.01rem) {
    .reference-apparatus {
      position: sticky;
      top: var(--nav-height, 3.25rem);
      z-index: 20;
    }
  }

  @media (max-width: 56rem) {
    .reference-apparatus-inner {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }

  .reference-list {
    border-bottom: 1px solid var(--color-rule);
  }

  .reference-entry {
    display: grid;
    grid-template-columns: minmax(9rem, 12rem) minmax(0, 1fr);
    gap: clamp(var(--space-lg), 5vw, var(--space-2xl));
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--color-rule);
  }

  .reference-entry-meta {
    align-self: start;
  }

  .reference-entry-body {
    min-width: 0;
  }

  .reference-entry-category {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    max-width: 100%;
    padding: 0.45rem 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--color-text-dim);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-weight: 400;
    line-height: 1.2;
    text-align: left;
    cursor: pointer;
    transition: color 0.18s ease;
  }

  .reference-entry-category:hover,
  .reference-entry-category:focus-visible {
    color: var(--color-accent);
  }

  .reference-entry-category span {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition: text-decoration-color 0.18s ease, text-decoration-thickness 0.18s ease;
  }

  .reference-entry-category:hover span,
  .reference-entry-category:focus-visible span {
    text-decoration-color: currentColor;
    text-decoration-thickness: 2px;
  }

  .reference-entry-title {
    max-width: var(--measure-reading);
    margin: 0;
    font-family: var(--font-prose);
    font-size: clamp(1.28rem, 2.15vw, 1.72rem);
    font-weight: 700;
    line-height: 1.25;
  }

  .reference-entry-title a {
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .reference-entry-title a:hover,
  .reference-entry-title a:focus-visible {
    color: var(--color-accent);
  }

  .reference-entry-external {
    display: inline-block;
    margin-left: 0.25em;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.72em;
    font-weight: 400;
    transform: translateY(-0.12em);
  }

  .reference-entry-byline {
    margin-top: 0.55rem;
    color: var(--color-text-secondary);
    font-family: var(--font-prose);
    font-size: var(--text-sm);
  }

  .reference-entry-year {
    color: var(--color-text-dim);
    font-family: var(--font-mono);
    font-size: 0.82em;
  }

  .reference-entry-note {
    max-width: var(--measure-reading);
    margin-top: 0.8rem;
    color: var(--color-text-secondary);
    font-family: var(--font-prose);
    font-size: var(--text-base);
    line-height: 1.65;
  }

  @media (max-width: 48rem) {
    .reference-apparatus-inner,
    .reference-results-inner {
      padding-inline: var(--space-md);
    }

    .reference-entry {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }

    .reference-entry-meta {
      order: 0;
    }

    .reference-entry-body {
      order: 1;
    }
  }

  @media (max-width: 36rem) {
    .reference-category-control {
      min-height: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reference-page * {
      transition-duration: 0.01ms !important;
    }
  }
</style>
