---
interface Props {
  threshold?: number;
  class?: string;
}

const { threshold = 480, class: className = '' } = Astro.props;
---

<button
  class:list={['back-to-top', className]}
  type="button"
  aria-label="Back to top"
  aria-hidden="true"
  tabindex="-1"
  data-back-to-top
  data-back-to-top-threshold={threshold}
>
  &uarr;
</button>

<script>
  const backToTopButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-back-to-top]'));

  for (const button of backToTopButtons) {
    if (button.dataset.backToTopBound === 'true') continue;
    button.dataset.backToTopBound = 'true';

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const configuredThreshold = Number.parseFloat(button.dataset.backToTopThreshold || '480');
    const minimumThreshold = Number.isFinite(configuredThreshold) ? configuredThreshold : 480;

    function updateBackToTop(): void {
      const shouldShow = window.scrollY > Math.max(minimumThreshold, window.innerHeight * 0.75);
      button.classList.toggle('is-visible', shouldShow);
      button.setAttribute('aria-hidden', shouldShow ? 'false' : 'true');
      button.tabIndex = shouldShow ? 0 : -1;
    }

    button.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: reducedMotion.matches ? 'auto' : 'smooth',
      });
    });

    window.addEventListener('scroll', updateBackToTop, { passive: true });
    window.addEventListener('resize', updateBackToTop);
    updateBackToTop();
  }
</script>

<style>
  .back-to-top {
    position: fixed;
    right: clamp(0.85rem, 2vw, 1.35rem);
    bottom: calc(clamp(0.85rem, 2vw, 1.35rem) + env(safe-area-inset-bottom, 0px));
    z-index: 30;
    display: grid;
    place-items: center;
    width: 2.35rem;
    height: 2.35rem;
    border: 1px solid color-mix(in srgb, var(--color-text-dim) 42%, var(--color-bg));
    border-radius: 0.38rem;
    background: var(--color-bg);
    color: var(--color-text-dim);
    font-family: var(--font-mono);
    font-size: 1.08rem;
    line-height: 1;
    opacity: 0;
    pointer-events: none;
    cursor: pointer;
    transform: translateY(0.35rem);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .back-to-top.is-visible {
    opacity: 0.86;
    pointer-events: auto;
    transform: translateY(0);
  }

  .back-to-top:hover,
  .back-to-top:focus-visible {
    border-color: var(--color-accent);
    background: var(--color-surface);
    color: var(--color-accent);
    opacity: 1;
  }

  .back-to-top:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 0.16rem;
  }

  @media (max-width: 900px) {
    .back-to-top {
      right: 0.85rem;
      bottom: calc(0.85rem + env(safe-area-inset-bottom, 0px));
      width: 2.45rem;
      height: 2.45rem;
      border-radius: 0.36rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: none;
    }
  }
</style>
