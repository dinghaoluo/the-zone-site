---
const pathname = Astro.url.pathname;

const links = [
  { href: '/glossary/', label: 'Glossary' },
  { href: '/reference/', label: 'Reference' },
];

function isActive(href: string): boolean {
  return pathname.startsWith(href);
}
---

<nav class="nav" aria-label="Primary">
  <div class="nav-inner container">
    <a class="nav-brand wordmark" href="/" aria-label="The Zone">
      <span>The</span><span>Zone</span>
    </a>
    <div class="nav-right">
      <ul class="nav-links" role="list">
        {links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={[{ active: isActive(href) }]}
              aria-current={isActive(href) ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Use light theme">
        <span class="theme-label" data-theme-label="d">d</span>
        <span class="theme-sep">/</span>
        <span class="theme-label" data-theme-label="l">l</span>
      </button>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('theme-toggle');
  const nav = document.querySelector('.nav') as HTMLElement | null;

  if (toggle) {
    function updateLabels() {
      const current = document.documentElement.dataset.theme || 'dark';
      toggle!.querySelectorAll('.theme-label').forEach(el => {
        const val = (el as HTMLElement).dataset.themeLabel;
        (el as HTMLElement).classList.toggle('active',
          (current === 'dark' && val === 'd') || (current === 'light' && val === 'l')
        );
      });
      toggle!.setAttribute(
        'aria-label',
        current === 'dark' ? 'Use light theme' : 'Use dark theme'
      );
    }

    const stored = localStorage.getItem('theme');
    if (stored === 'light' || stored === 'dark') {
      document.documentElement.dataset.theme = stored;
    }

    toggle.addEventListener('click', () => {
      const current = document.documentElement.dataset.theme || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
      updateLabels();
    });

    updateLabels();
  }
</script>
