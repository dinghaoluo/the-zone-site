---
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const sitePath = (path: string) => `${base}/${path.replace(/^\//, '')}`;
const pathname = Astro.url.pathname;

const links = [
  { href: sitePath('network/'), label: 'Network' },
  { href: sitePath('glossary/'), label: 'Glossary' },
  { href: sitePath('reference/'), label: 'Reference' },
];

function isActive(href: string): boolean {
  return pathname.startsWith(href);
}
---

<nav class="nav" aria-label="Primary">
  <div class="nav-inner container">
    <a class="nav-brand wordmark" href={`${base}/`} aria-label="The Zone">
      <span>The</span><span>Zone</span>
    </a>
    <div class="nav-right">
      <ul class="nav-links" role="list">
        {links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={[{ active: isActive(href) }]}
              aria-current={isActive(href) ? 'page' : undefined}
            >
              [ {label} ]
            </a>
          </li>
        ))}
      </ul>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Use light theme">
        <span class="theme-label" data-theme-label="d">d</span>
        <span class="theme-sep">/</span>
        <span class="theme-label" data-theme-label="l">l</span>
      </button>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('theme-toggle');
  const nav = document.querySelector('.nav') as HTMLElement | null;

  if (toggle) {
    function updateLabels() {
      const current = document.documentElement.dataset.theme || 'dark';
      toggle!.querySelectorAll('.theme-label').forEach(el => {
        const val = (el as HTMLElement).dataset.themeLabel;
        (el as HTMLElement).classList.toggle('active',
          (current === 'dark' && val === 'd') || (current === 'light' && val === 'l')
        );
      });
      toggle!.setAttribute(
        'aria-label',
        current === 'dark' ? 'Use light theme' : 'Use dark theme'
      );
    }
    updateLabels();

    toggle.addEventListener('click', () => {
      const current = document.documentElement.dataset.theme || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
      updateLabels();
    });
  }

  if (nav) {
    const ro = new ResizeObserver(entries => {
      for (const entry of entries) {
        const h = entry.borderBoxSize?.[0]?.blockSize ?? entry.target.getBoundingClientRect().height;
        document.documentElement.style.setProperty('--nav-height', `${h}px`);
      }
    });
    ro.observe(nav);
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-nav-bg);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--measure-site);
    min-height: 3.25rem;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  .nav-brand {
    font-family: var(--font-display);
    font-size: 1.3rem;
    letter-spacing: 0;
    color: var(--color-text);
    background-image: none;
  }

  .nav-brand:hover {
    color: var(--color-accent);
  }

  .nav-links {
    display: flex;
    gap: 1.4rem;
    list-style: none;
  }

  .nav-links a {
    font-family: var(--font-figure);
    font-size: var(--text-base);
    font-weight: 400;
    color: var(--color-text-dim);
    letter-spacing: 0;
    transition: color 0.2s ease, background-size 0.25s ease;
    padding: 0.4rem 0;
  }

  .nav-links a:hover,
  .nav-links a:focus-visible {
    color: var(--color-text-secondary);
  }

  .nav-links a.active {
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .nav-inner {
      display: flex;
      width: 100%;
      max-width: none;
      min-height: 3.15rem;
      gap: 0.65rem;
      padding-inline: var(--space-md);
    }

    .nav-brand {
      flex-shrink: 0;
      margin-right: auto;
      font-size: 0.96rem;
      line-height: 1;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
    }

    .theme-toggle {
      font-size: 0.8rem;
      padding: 0;
      min-height: 44px;
      min-width: 2.25rem;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .nav-right {
      flex: 0 0 auto;
      min-width: 0;
      gap: 0.3rem;
    }

    .nav-links {
      gap: clamp(0.5rem, 2.6vw, 0.75rem);
    }

    .nav-links a {
      font-size: 0.84rem;
      white-space: nowrap;
      min-height: 44px;
      padding: 0;
      line-height: 1;
      display: flex;
      align-items: center;
    }
  }

  .theme-toggle {
    display: flex;
    align-items: baseline;
    gap: 0;
    font-family: var(--font-figure);
    font-size: 0.75rem;
    letter-spacing: 0;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.2rem 0;
    color: var(--color-text-dim);
    transition: color 0.2s;
  }

  .theme-toggle:hover {
    color: var(--color-text-secondary);
  }

  .theme-sep {
    color: var(--color-border);
    margin: 0 0.15rem;
  }

  .theme-label {
    opacity: 0.4;
    transition: opacity 0.2s, color 0.2s;
  }

  .theme-label.active {
    opacity: 1;
    color: var(--color-accent);
  }
</style>
