---
const referenceBars = [
  '--color-accent',
  '--color-accent',
  '--plotline-tchitcherine',
  '--plotline-pokler',
  '--plotline-pokler',
  '--color-text-dim',
  '--color-text-dim',
];
---

<span class="reference-preview" aria-hidden="true">
  <svg viewBox="0 0 120 72" preserveAspectRatio="none">
    <rect class="reference-spine" x="8" y="2" width="8" height="67" rx="4" />
    {referenceBars.map((cssVar, index) => (
      <rect
        class="reference-bar"
        x="26"
        y={3 + index * 9.8}
        width="88"
        height="7"
        rx="3.5"
        style={`fill: var(${cssVar})`}
      />
    ))}
  </svg>
</span>

<style>
  .reference-preview {
    display: block;
    width: 5.4rem;
    max-width: 100%;
    aspect-ratio: 5 / 3;
  }

  .reference-preview svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .reference-spine {
    fill: var(--color-text-dim);
    opacity: 0.32;
  }

  .reference-bar {
    opacity: 0.88;
  }

  @media (max-width: 48rem) {
    .reference-preview {
      width: 4.8rem;
    }
  }
</style>
