---
import { episodePartLengths, episodeWordCounts } from '../data/episodeWordCounts';

const partLabels = ['Part 1', 'Part 2', 'Part 3', 'Part 4'];

const maxWords = Math.max(...episodeWordCounts);
const BAR_W = 10;
const BAR_GAP = 3;
const PART_GAP = 20;
const MAX_H = 320;
const LABEL_H = 28;
const PAD_TOP = 48;

let x = 0;
let partIdx = 0;
let countInPart = 0;

type Bar = { x: number; h: number; fill: string; words: number; epId: string };
const bars: Bar[] = [];

const partStartX: number[] = [];
const partEndX: number[] = [];

for (let i = 0; i < episodeWordCounts.length; i++) {
  const w = episodeWordCounts[i];
  if (countInPart >= episodePartLengths[partIdx]) {
    partEndX.push(x - BAR_GAP);
    partIdx++;
    countInPart = 0;
    x += PART_GAP;
  }
  if (countInPart === 0) partStartX.push(x);
  const epNum = countInPart + 1;
  const partNum = partIdx + 1;
  const epId = `${partNum}.${String(epNum).padStart(2, '0')}`;

  const fill = `var(--color-part-${partNum})`;

  bars.push({ x, h: (w / maxWords) * MAX_H, fill, words: w, epId });
  x += BAR_W + BAR_GAP;
  countInPart++;
}
partEndX.push(x - BAR_GAP);

const totalW = x;
const totalH = PAD_TOP + MAX_H + LABEL_H;
---

<div
  class="sparkline-wrap"
  data-bar-pad-top={PAD_TOP}
  style={`--sparkline-scroll-width: ${totalW}px;`}
>
  <h2 class="sparkline-title" id="episode-word-count-title">
    Seventy-three episodes by word count
  </h2>
  <div class="sp-tooltip" id="sp-tooltip" role="tooltip" aria-hidden="true"></div>
  <div class="sparkline-scroll h-scroll-fade">
    <div
      class="h-scroll-fade__scroller"
      role="region"
      aria-labelledby="episode-word-count-title"
      tabindex="0"
    >
      <svg
        class="sparkline"
        viewBox={`0 0 ${totalW} ${totalH}`}
        preserveAspectRatio="xMidYMid meet"
        role="img"
        aria-label="Seventy-three episodes across four parts; bar height follows word count"
      >
        {bars.map((b, index) => (
          <rect
            x={b.x}
            y={PAD_TOP + MAX_H - b.h}
            width={BAR_W}
            height={b.h}
            fill={b.fill}
            opacity="0.9"
            rx="1"
            data-ep={b.epId}
            data-words={b.words}
            tabindex={index === 0 ? '0' : '-1'}
            role="button"
            aria-label={`Episode ${b.epId}, ${b.words.toLocaleString('en-GB')} words`}
            aria-pressed="false"
          />
        ))}

        {partLabels.map((label, pi) => {
          const cx = (partStartX[pi] + partEndX[pi]) / 2;
          return (
            <text
              class="sparkline-part-label plot-label"
              x={cx}
              y={PAD_TOP + MAX_H + 22}
              text-anchor="middle"
              fill="var(--color-text-dim)"
              font-family="var(--plot-label-font)"
            >{label}</text>
          );
        })}

        {partStartX.slice(1).map(sx => (
          <line
            x1={sx - PART_GAP / 2}
            y1={PAD_TOP + 10}
            x2={sx - PART_GAP / 2}
            y2={PAD_TOP + MAX_H + 4}
            stroke="var(--color-border)"
            stroke-width="0.5"
            stroke-dasharray="3,3"
            opacity="0.4"
          />
        ))}
      </svg>
    </div>
  </div>
</div>

<script>
  import { scalePlotLabels } from '../lib/plotLabels';

  const svg = document.querySelector('.sparkline') as SVGSVGElement;
  if (svg) {
    const bars = Array.from(
      svg.querySelectorAll<SVGRectElement>('rect[data-ep]')
    );
    const title = document.getElementById('episode-word-count-title');
    const tooltip = document.getElementById('sp-tooltip');
    const wrap = svg.closest('.sparkline-wrap') as HTMLElement | null;
    const tooltipBarTop = Number(wrap?.dataset.barPadTop || '48');

    function scalePartLabels() {
      scalePlotLabels(svg);
    }

    function alignTitle() {
      if (!title) return;
      const rendered = svg.getBoundingClientRect();
      const viewBox = svg.viewBox.baseVal;
      if (!rendered.width || !rendered.height || !viewBox.width || !viewBox.height) return;

      const scale = Math.min(rendered.width / viewBox.width, rendered.height / viewBox.height);
      const plotWidth = viewBox.width * scale;
      title.style.marginInlineStart = `${Math.max(0, (rendered.width - plotWidth) / 2)}px`;
    }

    function updateLayout() {
      scalePartLabels();
      alignTitle();
    }

    updateLayout();
    window.addEventListener('resize', updateLayout);

    const titles: Record<string, string> = {
      '1.01': 'Banana Dawn',
      '1.02': 'The Banana Breakfast',
      '1.03': 'The Map on the Wall',
      '1.04': 'Slothrop\'s Stars',
      '1.05': 'The Séance',
      '1.06': 'The White Visitation',
      '1.07': 'The Dog Chase',
      '1.08': 'Spectro at Night',
      '1.09': 'Mexico vs Pointsman',
      '1.10': 'Sodium Amytal',
      '1.11': 'Pirate\'s Drawing',
      '1.12': 'PISCES',
      '1.13': 'Jamf at Harvard',
      '1.14': 'The Oven-State',
      '1.15': 'Mrs Quoad\'s Sweets',
      '1.16': 'Roger and Jessica',
      '1.17': 'Gwenhidwy\'s Hospital',
      '1.18': 'Psi Section',
      '1.19': 'Rathenau\'s Spirit',
      '1.20': 'Christmas at the Visitation',
      '1.21': 'Boxing Day Pantomime',
      '2.01': 'Casino Hermann Goering',
      '2.02': 'First Night with Katje',
      '2.03': 'The Rocket Curriculum',
      '2.04': 'Pointsman\'s Conspiracy',
      '2.05': 'Shell and the Benzene Ring',
      '2.06': 'The Green Suit Party',
      '2.07': 'Ian Scuffling',
      '2.08': 'The Castration of Pointsman',
      '3.01': 'Nordhausen Documents',
      '3.02': 'The Tunnels',
      '3.03': 'The Erdschweinhöhle',
      '3.04': 'The Brocken',
      '3.05': 'The Kirghiz Light',
      '3.06': 'Mba-kayere',
      '3.07': 'Max Schlepzig',
      '3.08': 'The Argentine U-Boat',
      '3.09': 'Tchitcherine\'s Pipe',
      '3.10': 'Margherita on the Set',
      '3.11': 'Franz und Ilse',
      '3.12': 'Rocketman in Berlin',
      '3.13': 'The Toiletship',
      '3.14': 'Bad Karma',
      '3.15': 'Bianca',
      '3.16': 'Alpdrücken',
      '3.17': 'Greta\'s Film Lives',
      '3.18': 'Storm on the Anubis',
      '3.19': 'Frau Gnahb',
      '3.20': 'Mondaugen\'s Law',
      '3.21': 'Three Movements',
      '3.22': 'Springer\'s Chase',
      '3.23': 'The Counterforce Gathers',
      '3.24': 'Slothrop Drifting',
      '3.25': 'On Preterition',
      '3.26': 'Tchitcherine in Ashes',
      '3.27': 'Plechazunga',
      '3.28': 'Jamf\'s Last Lectures',
      '3.29': 'Kekulé\'s Dream',
      '3.30': 'Lyle Bland Ascends',
      '3.31': 'The Pig Suit',
      '3.32': 'Guitars in the Copse',
      '4.01': 'Pirate\'s Green Plane',
      '4.02': 'Roger Unmoored',
      '4.03': 'Byron the Bulb',
      '4.04': 'Katje and the Schwarzkommando',
      '4.05': '175-Stadt',
      '4.06': 'Raketen-Stadt',
      '4.07': 'Tchitcherine Remembers',
      '4.08': 'The Disgusting Duo',
      '4.09': 'Geli\'s Spell',
      '4.10': 'The 00001',
      '4.11': 'The Un-recognition',
      '4.12': 'The Last Delta-t',
    };

    let locked: SVGRectElement | null = null;

    function positionTooltip(bar: SVGRectElement) {
      if (!tooltip || !wrap) return;
      const barRect = bar.getBoundingClientRect();
      const wrapRect = wrap.getBoundingClientRect();
      const svgRect = svg.getBoundingClientRect();
      const tipW = tooltip.offsetWidth || 120;
      const tipH = tooltip.offsetHeight || 0;
      let left = barRect.left - wrapRect.left + barRect.width / 2 - tipW / 2;
      left = Math.max(4, Math.min(left, wrapRect.width - tipW - 4));
      tooltip.style.left = `${left}px`;
      tooltip.style.top = `${Math.max(
        0,
        svgRect.top - wrapRect.top + tooltipBarTop - tipH - 8
      )}px`;
    }

    function showInfo(bar: SVGRectElement) {
      bar.setAttribute('opacity', '1');
      bar.setAttribute('stroke', 'var(--color-text)');
      bar.setAttribute('stroke-width', '1.5');
      if (!tooltip) return;

      const ep = bar.dataset.ep || '';
      const words = Number(bar.dataset.words || 0).toLocaleString('en-GB');
      const parts = [ep];
      if (titles[ep]) parts.push(titles[ep]);
      parts.push(`${words} words`);
      tooltip.textContent = parts.join('  ·  ');
      tooltip.style.opacity = '1';
      tooltip.setAttribute('aria-hidden', 'false');
      requestAnimationFrame(() => positionTooltip(bar));
    }

    function hideInfo(bar: SVGRectElement) {
      bar.setAttribute('opacity', '0.9');
      bar.removeAttribute('stroke');
      bar.removeAttribute('stroke-width');
      if (!tooltip) return;

      tooltip.style.opacity = '0';
      tooltip.setAttribute('aria-hidden', 'true');
    }

    function unlock() {
      if (!locked) return;
      locked.setAttribute('aria-pressed', 'false');
      hideInfo(locked);
      locked = null;
    }

    function toggleLock(bar: SVGRectElement) {
      if (locked === bar) {
        unlock();
        return;
      }
      unlock();
      locked = bar;
      locked.setAttribute('aria-pressed', 'true');
      showInfo(locked);
    }

    function focusBar(index: number) {
      const next = bars[index];
      if (!next) return;
      bars.forEach(bar => bar.setAttribute('tabindex', bar === next ? '0' : '-1'));
      next.focus();
      next.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    }

    bars.forEach((bar, index) => {
      bar.addEventListener('mouseenter', () => {
        if (locked && locked !== bar) return;
        showInfo(bar);
      });
      bar.addEventListener('mouseleave', () => {
        if (locked) return;
        hideInfo(bar);
      });
      bar.addEventListener('click', (event) => {
        event.stopPropagation();
        toggleLock(bar);
      });
      bar.addEventListener('focus', () => {
        if (locked && locked !== bar) return;
        showInfo(bar);
      });
      bar.addEventListener('blur', () => {
        if (locked) return;
        hideInfo(bar);
      });
      bar.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          toggleLock(bar);
        } else if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
          event.preventDefault();
          unlock();
          focusBar(Math.min(bars.length - 1, index + 1));
        } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
          event.preventDefault();
          unlock();
          focusBar(Math.max(0, index - 1));
        } else if (event.key === 'Home') {
          event.preventDefault();
          unlock();
          focusBar(0);
        } else if (event.key === 'End') {
          event.preventDefault();
          unlock();
          focusBar(bars.length - 1);
        } else if (event.key === 'Escape') {
          event.preventDefault();
          unlock();
          bar.blur();
        }
      });
    });

    svg.addEventListener('click', unlock);
    document.addEventListener('click', (event) => {
      if (locked && !svg.contains(event.target as Node)) unlock();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') unlock();
    });
  }
</script>

<style>
  .sparkline-wrap {
    position: relative;
  }

  .sparkline-title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 400;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-sm);
  }

  .sparkline {
    display: block;
    width: 100%;
    height: clamp(18rem, 40vh, 28rem);
    cursor: crosshair;
  }

  .sparkline rect[data-ep] {
    transition: opacity 0.15s, stroke 0.15s;
  }

  .sparkline-part-label {
    font-family: var(--plot-label-font);
    font-weight: var(--plot-label-weight);
  }

  .sp-tooltip {
    position: absolute;
    z-index: 5;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-accent);
    opacity: 0;
    pointer-events: none;
    white-space: nowrap;
    transition: opacity 0.2s;
  }

  @media (max-width: 72rem) {
    .sparkline {
      width: max(100%, var(--sparkline-scroll-width));
      height: auto;
    }
  }

  @media (max-width: 30rem) {
    .sp-tooltip {
      font-size: 0.75rem;
    }
  }

</style>
