<footer class="footer">
  <div class="footer-inner container">
    <a class="footer-source" href="https://github.com/dinghaoluo/the-zone-site">source</a>
    <span class="footer-kilroy" aria-hidden="true" title="Kilroy was here">
      <svg viewBox="0 0 80 32" xmlns="http://www.w3.org/2000/svg">
        <line x1="4" y1="24" x2="76" y2="24" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
        <path
          d="M22 24 C22 20 24 18 27 18 L34 18 L36 14 L40 12 L44 14 L52 14 L52 18 L54 18 C57 18 58 20 58 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linejoin="round"
          stroke-linecap="round"
        />
        <circle cx="40" cy="16" r="0.9" fill="currentColor" />
        <circle cx="46" cy="16" r="0.9" fill="currentColor" />
        <path d="M20 24 L22 22 L22 24 Z M60 24 L58 22 L58 24 Z" fill="currentColor" />
      </svg>
    </span>
    <a class="footer-author" href="https://dinghaoluo.github.io" target="_blank" rel="noopener">&copy; 2026 Dinghao Luo</a>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border-subtle);
    padding: var(--space-lg) 0;
    margin-top: var(--space-xl);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--measure-site);
    font-family: var(--font-prose);
    font-size: var(--text-sm);
    color: var(--color-text-dim);
  }

  .footer-source {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-source:hover,
  .footer-source:focus-visible {
    color: var(--color-accent);
  }

  .footer-author {
    font: inherit;
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-author:hover,
  .footer-author:focus-visible {
    color: var(--color-accent);
  }

  .footer-kilroy {
    display: inline-flex;
    align-items: center;
    width: 3.5rem;
    height: 1.4rem;
    color: var(--color-text-dim);
    opacity: 0.75;
  }

  .footer-kilroy svg {
    width: 100%;
    height: 100%;
  }
</style>
