<footer class="footer">
  <div class="footer-inner container">
    <a class="footer-source" href="https://github.com/dinghaoluo/the-zone-site">source</a>
    <a class="footer-author" href="https://dinghaoluo.github.io" target="_blank" rel="noopener">&copy; Dinghao Luo</a>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border-subtle);
    padding: var(--space-lg) 0;
    margin-top: var(--space-xl);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--measure-site);
    font-family: var(--font-prose);
    font-size: var(--text-sm);
    color: var(--color-text-dim);
  }

  .footer-source {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-source:hover,
  .footer-source:focus-visible {
    color: var(--color-accent);
  }

  .footer-author {
    font: inherit;
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-author:hover,
  .footer-author:focus-visible {
    color: var(--color-accent);
  }
</style>
