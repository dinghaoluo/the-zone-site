---
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
---

<footer class="footer">
  <div class="footer-inner container">
    <a class="footer-source" href="https://github.com/dinghaoluo/the-zone-site">source</a>
    <span class="footer-kilroy" aria-hidden="true" title="Kilroy was here">
      <img src={`${base}/kilroy.png`} alt="" />
    </span>
    <a class="footer-author" href="https://dinghaoluo.github.io" target="_blank" rel="noopener">&copy; 2026 Dinghao Luo</a>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border-subtle);
    padding: var(--space-lg) 0;
    margin-top: var(--space-xl);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--measure-site);
    font-family: var(--font-prose);
    font-size: var(--text-sm);
    color: var(--color-text-dim);
  }

  .footer-source {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-source:hover,
  .footer-source:focus-visible {
    color: var(--color-accent);
  }

  .footer-author {
    font: inherit;
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-author:hover,
  .footer-author:focus-visible {
    color: var(--color-accent);
  }

  .footer-kilroy {
    display: inline-flex;
    align-items: center;
    width: 8.4rem;
    height: 4.2rem;
    opacity: 0.5;
    margin-left: 5rem;
  }

  .footer-kilroy img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: invert(1) brightness(0.72);
  }

  :global([data-theme="light"]) .footer-kilroy img {
    filter: none;
  }
</style>
