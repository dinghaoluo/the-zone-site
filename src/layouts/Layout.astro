---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A visual companion to Gravity\'s Rainbow (1973).' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title === 'Home' ? 'The Zone' : `${title} · The Zone`}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/zone-favicon-dark.svg" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/zone-favicon-light.svg" media="(prefers-color-scheme: light)" />
    <link rel="stylesheet" href="/fonts.css" />
  </head>
  <body>
    <slot name="nav" />
    <slot />
    <slot name="footer" />
  </body>
</html>

<style>
  @import '../styles/global.css';
</style>
