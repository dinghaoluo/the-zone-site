---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'A visual companion to Gravity\'s Rainbow (1973).',
} = Astro.props;
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/?$/, '/');
const documentTitle = title === 'Home'
  ? 'The Zone: A Visual Companion to Gravity\'s Rainbow'
  : `${title} · The Zone`;
const canonicalPath = Astro.url.pathname.replace(/\/?$/, '/');
const canonicalURL = Astro.site ? new URL(canonicalPath, Astro.site) : Astro.url;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={`${base}zone-favicon-light.svg`} media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href={`${base}zone-favicon-dark.svg`} media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={`${base}zone-favicon-light.svg`} />
    <link rel="stylesheet" href={`${base}fonts.css`} />

    <title>{documentTitle}</title>
    <script is:inline>
      (function() {
        var stored = localStorage.getItem('theme');
        document.documentElement.dataset.theme = stored || 'dark';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot name="nav" />
    <slot />
    <slot name="footer" />

    <script>
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const disclosureTime = getComputedStyle(document.documentElement).getPropertyValue('--disclosure-duration').trim();
      const disclosureDuration = parseFloat(disclosureTime) * (disclosureTime.endsWith('ms') ? 1 : 1000);

      document.querySelectorAll<HTMLDetailsElement>('details').forEach(details => {
        const summary = details.querySelector('summary')!;
        const content = summary.nextElementSibling as HTMLElement;
        let expanded = details.open;
        let animation: Animation | null = null;
        let fade: Animation | null = null;
        let settledHeight = details.getBoundingClientRect().height;
        details.dataset.expanded = String(expanded);

        function setExpanded(open: boolean, height = details.getBoundingClientRect().height) {
          const opacity = details.open ? getComputedStyle(content).opacity : '0';
          animation?.cancel();
          fade?.cancel();
          expanded = open;
          details.dataset.expanded = String(open);
          details.open = true;
          const endHeight = open ? details.getBoundingClientRect().height
            : summary.getBoundingClientRect().height + details.offsetHeight - details.clientHeight;
          const duration = reducedMotion.matches ? 0 : disclosureDuration;
          details.style.overflow = 'clip';
          animation = details.animate([{ height: `${height}px` }, { height: `${endHeight}px` }], {
            duration, easing: 'ease', fill: 'both',
          });
          fade = content.animate([{ opacity }, { opacity: open ? 1 : 0 }], {
            duration, easing: 'ease', fill: 'both',
          });
          animation.onfinish = () => {
            details.open = expanded;
            animation?.cancel();
            fade?.cancel();
            animation = null;
            details.style.overflow = '';
            settledHeight = details.getBoundingClientRect().height;
          };
        }

        summary.addEventListener('click', event => {
          event.preventDefault();
          setExpanded(!expanded);
        });
        details.addEventListener('toggle', () => {
          if (animation) return;
          expanded = details.open;
          details.dataset.expanded = String(expanded);
        });
        new ResizeObserver(() => {
          if (expanded) setExpanded(true, animation ? undefined : settledHeight);
        }).observe(content);
      });

      document.querySelectorAll('.h-scroll-fade').forEach(outer => {
        const scroller = outer.querySelector('.h-scroll-fade__scroller') as HTMLElement | null;
        if (!scroller) return;

        function updateFades() {
          const sl = scroller!.scrollLeft;
          const maxSl = scroller!.scrollWidth - scroller!.clientWidth;
          const scrollable = maxSl > 2;
          const atLeft = sl <= 2;
          const atRight = !scrollable || sl >= maxSl - 2;
          outer.classList.toggle('can-scroll', scrollable);
          outer.classList.toggle('is-at-left', atLeft);
          outer.classList.toggle('is-at-right', atRight);
          outer.classList.toggle('can-scroll-right', scrollable && sl < maxSl - 2);
          outer.classList.toggle('can-scroll-left', scrollable && sl > 2);
        }
        updateFades();
        scroller.addEventListener('scroll', updateFades, { passive: true });
        window.addEventListener('resize', updateFades);
        if ('ResizeObserver' in window) {
          new ResizeObserver(updateFades).observe(scroller);
        }

        const DRAG_THRESHOLD = 4;
        let isDragging = false;
        let hasMoved = false;
        let startX = 0;
        let startScroll = 0;
        let capturedPointerId: number | null = null;

        scroller.addEventListener('pointerdown', (e: PointerEvent) => {
          if (e.pointerType === 'touch') return;
          if (scroller!.scrollWidth <= scroller!.clientWidth + 2) return;
          isDragging = true;
          hasMoved = false;
          startX = e.clientX;
          startScroll = scroller!.scrollLeft;
          scroller!.classList.add('can-drag');
        });

        scroller.addEventListener('pointermove', (e: PointerEvent) => {
          if (!isDragging) return;
          const dx = e.clientX - startX;
          if (!hasMoved && Math.abs(dx) < DRAG_THRESHOLD) return;
          if (!hasMoved) {
            hasMoved = true;
            capturedPointerId = e.pointerId;
            scroller!.setPointerCapture(e.pointerId);
            scroller!.classList.add('is-dragging');
            outer.classList.add('is-dragging');
          }
          scroller!.scrollLeft = startScroll - dx;
          updateFades();
        });

        const endDrag = () => {
          if (!isDragging) return;
          isDragging = false;
          scroller!.classList.remove('is-dragging', 'can-drag');
          outer.classList.remove('is-dragging');
          if (capturedPointerId !== null && scroller!.hasPointerCapture(capturedPointerId)) {
            scroller!.releasePointerCapture(capturedPointerId);
          }
          capturedPointerId = null;
          if (hasMoved) {
            scroller!.addEventListener('click', (e) => e.stopPropagation(), { once: true, capture: true });
          }
          updateFades();
        };
        scroller.addEventListener('pointerup', endDrag);
        scroller.addEventListener('pointercancel', endDrag);
        scroller.addEventListener('lostpointercapture', endDrag);
      });
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
